# Omaxian OS package repository (https://apt.omaxian.org, signed with the
# Omaxian OS archive key in /usr/share/keyrings/omaxian-archive-keyring.pgp).
# Enabled by default since omaxian-base 0.1.7. To turn it off set "Enabled: no"
# (dpkg then keeps your choice on upgrades).
Enabled: yes
Types: deb
URIs: https://apt.omaxian.org
Suites: excalibur
Components: main
Architectures: amd64 all
Signed-By: /usr/share/keyrings/omaxian-archive-keyring.pgp
