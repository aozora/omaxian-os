# Omaxian OS package repository (Cloudflare R2: bucket omaxian-apt).
# Disabled until the repository is published and signed with the release key
# (docs/signing-key.md). Enable with: sed -i 's/^Enabled: no/Enabled: yes/' this file
Enabled: no
Types: deb
URIs: https://apt.omaxian.org
Suites: excalibur
Components: main
Architectures: amd64 all
Signed-By: /usr/share/keyrings/omaxian-archive-keyring.pgp
