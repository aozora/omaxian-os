#!/bin/sh
# calamares-locale-formats [ROOT]
#
# Safety net after localecfg (the omaxianlocale job already fixes Calamares'
# global storage): an LC_* value that is a bare language tag ("en", "it"; the
# Locale page's automatic formats on Omaxian live media, see
# /usr/share/i18n/SUPPORTED) or empty is replaced with LANG. Full locale names
# (an explicit choice made with "Change...") are kept.
set -u
ROOT=${1:-}
DEF=$ROOT/etc/default/locale
[ -f "$DEF" ] || exit 0
LANGV=$(sed -n 's/^LANG=//p' "$DEF" | tail -n1 | tr -d '"')
[ -n "$LANGV" ] || exit 0
for f in "$DEF" "$ROOT/etc/locale.conf"; do
	[ -f "$f" ] || continue
	tmp=$f.omaxian-tmp
	awk -v lang="$LANGV" '
		/^LC_[A-Z_]+=/ {
			k = $0; sub(/=.*/, "", k)
			v = $0; sub(/^[^=]*=/, "", v); gsub(/"/, "", v)
			if (v == "" || v ~ /^[a-z][a-z][a-z]?$/) { print k "=" lang; next }
		}
		{ print }' "$f" > "$tmp" && cat "$tmp" > "$f"
	rm -f "$tmp"
done
exit 0
