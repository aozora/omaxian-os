#!/bin/sh
set -e
SRC=/usr/share/omaxian/src
if [ "$1" = configure ]; then
	# Quickshell must reach the session bus (Omaxian setup.sh does the same)
	OPTS=/etc/X11/Xsession.options
	if [ -f "$OPTS" ] && ! grep -qxF use-session-dbus "$OPTS"; then
		echo use-session-dbus >> "$OPTS"
	fi
	# omarchy-dns re-execs this root-owned path under sudo/pkexec
	if [ -f "$SRC/omaxian/.local/share/omarchy/bin/omarchy-dns" ]; then
		install -D -o root -g root -m 0755 "$SRC/omaxian/.local/share/omarchy/bin/omarchy-dns" \
			/usr/local/libexec/omaxian/omarchy-dns
	fi
	# The home template is NOT copied to /etc/skel any more (it doubled the
	# image size): /etc/X11/Xsession.d/25omaxian-home seeds each home at the
	# first graphical login. Clean up the copy older versions put in /etc/skel.
	if [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.0.3-2 && [ -d /usr/share/omaxian/home-template ]; then
		( cd /usr/share/omaxian/home-template && find . -type f -o -type l ) | while read -r f; do
			[ -e "/etc/skel/$f" ] || [ -L "/etc/skel/$f" ] || continue
			cmp -s "/usr/share/omaxian/home-template/$f" "/etc/skel/$f" 2>/dev/null || [ -L "/etc/skel/$f" ] && rm -f "/etc/skel/$f"
		done
		find /etc/skel -mindepth 1 -type d -empty -delete 2>/dev/null || true
	fi
fi
#DEBHELPER#
exit 0
