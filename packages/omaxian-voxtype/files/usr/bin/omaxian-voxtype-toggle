#!/bin/sh
# Omaxian OS: start/stop VoxType dictation (i3: Super+Ctrl+V).
# No systemd user session here: the daemon is started on demand, per user,
# with its built-in evdev hotkey off (no "input" group needed). The text goes
# to the X11 clipboard (xclip): paste it with Ctrl+V / Shift+Insert.
M="${XDG_DATA_HOME:-$HOME/.local/share}/voxtype/models"
running() { pgrep -u "$(id -u)" -f '^/usr/lib/voxtype/voxtype-[a-z0-9-]+ .*daemon' >/dev/null; }
if ! running; then
	if ! ls "$M"/* >/dev/null 2>&1; then
		notify-send -a VoxType "VoxType" "No speech model yet: choose one in the terminal (needs internet)."
		exec kitty --title "VoxType setup" sh -c 'voxtype setup model; echo; echo "Done. Press Super+Ctrl+V to dictate."; read -r _'
	fi
	setsid -f voxtype -q daemon --clipboard >/dev/null 2>&1 < /dev/null
	i=0; while [ $i -lt 20 ] && ! running; do sleep 0.25; i=$((i+1)); done
	notify-send -a VoxType -t 2000 "VoxType" "Dictation ready"
fi
exec voxtype record toggle
