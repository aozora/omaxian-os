#!/bin/sh
# Records an optional Flatpak picked on the installer's "Applications" page.
#   omaxian-optional-flatpak select <app-id>
# Run by Calamares' packages module (target chroot) as the post-install step
# of the group (netinstall.conf, scripts/gen-netinstall.sh). omaxian-firstboot
# installs the picked apps (base ISO: from Flathub once online) or removes the
# unpicked ones (full ISO: all optional Flatpaks are preinstalled offline).
set -eu
L=${OMAXIAN_FB_ROOT:-}/var/lib/omaxian/optional-flatpaks.list
[ "${1:-}" = select ] && [ -n "${2:-}" ] || { echo "usage: $0 select <app-id>" >&2; exit 2; }
mkdir -p "${L%/*}"; touch "$L"
grep -qx "$2" "$L" || echo "$2" >> "$L"
