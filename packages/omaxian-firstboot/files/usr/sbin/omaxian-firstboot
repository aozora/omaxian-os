#!/bin/bash
# Omaxian OS first-boot provisioning (root). Log: /var/log/omaxian-firstboot.log
#   --boot        called from /etc/init.d/omaxian-firstboot (waits for network)
#   --now         run immediately (e.g. after connecting Wi-Fi)
set -u
LOG=/var/log/omaxian-firstboot.log
STATE=/var/lib/omaxian
CACHE=$STATE/appimages
FLATPAKS=/usr/share/omaxian/flatpaks.list
MANIFEST=/usr/share/omaxian/appimages.manifest
mkdir -p "$STATE" "$CACHE"
exec >>"$LOG" 2>&1
echo "== $(date -Is) omaxian-firstboot $*"

# Flathub/GitHub (Flatpaks, AppImages) and the apt mirror are checked
# separately: a network that reaches the distro mirror but not Flathub (or the
# other way round) still gets the steps it can do.
online() { curl -fsS --max-time 8 -o /dev/null https://dl.flathub.org/repo/summary.idx 2>/dev/null || curl -fsS --max-time 8 -o /dev/null https://github.com 2>/dev/null; }
apt_uri() {
	local u
	u=$(awk 'tolower($1)=="uris:"{print $2; exit}' /etc/apt/sources.list.d/devuan.sources 2>/dev/null)
	[ -n "$u" ] || u=$(awk '$1=="deb"{for(i=2;i<=NF;i++) if($i ~ /^(https?|ftp):/){print $i; exit}}' /etc/apt/sources.list 2>/dev/null)
	printf '%s' "$u"
}
# any HTTP answer from the main apt mirror counts as reachable
apt_online() { local u; u=$(apt_uri); [ -n "$u" ] && [ "$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 "${u%/}/dists/" 2>/dev/null)" != 000 ]; }
SELECTED=$STATE/optional-packages.list
PENDING=$STATE/optional-pending.list
need_apt() { [ -s "$PENDING" ]; }

if [ "${1:-}" = --boot ]; then
	for _ in $(seq 1 60); do online && break; need_apt && apt_online && break; sleep 10; done
fi
NET=0; online && NET=1
APT=0; need_apt && apt_online && APT=1
if [ $NET = 0 ] && [ $APT = 0 ]; then echo "offline: will retry at next boot (or run: sudo omaxian-firstboot --now)"; exit 0; fi

rc=0
# 0. Optional apt groups picked in the installer (Calamares netinstall page)
#    that could not be installed then (base ISO, offline). Idempotent: only
#    packages that are still missing are installed; the pending list shrinks.
installed() { [ "$(dpkg-query -W -f '${db:Status-Status}' "$1" 2>/dev/null)" = installed ]; }
if need_apt && [ $APT = 0 ]; then
	echo "!! apt mirror $(apt_uri) unreachable: optional packages stay pending"; rc=1
elif need_apt; then
	mapfile -t want < <(grep -vE '^\s*(#|$)' "$PENDING")
	missing=(); for p in "${want[@]}"; do installed "$p" || missing+=("$p"); done
	if [ ${#missing[@]} -gt 0 ]; then
		echo "apt: installing optional packages: ${missing[*]}"
		export DEBIAN_FRONTEND=noninteractive
		APTI="apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install"
		# one unreachable third-party source must not block the rest:
		# go on with whatever lists apt could fetch
		apt-get update || echo "!! apt-get update reported errors (continuing with the lists it got)"
		# one package (with its dependencies) per apt run: a single large
		# transaction got apt-get OOM-killed on a 2.75 GiB machine, and each
		# finished package is kept even if a later one fails
		for p in "${missing[@]}"; do
			installed "$p" && continue
			echo "apt: $p"
			nice -n 10 $APTI "$p" || echo "!! apt $p failed"
		done
	fi
	still=(); for p in "${want[@]}"; do installed "$p" || still+=("$p"); done
	printf '%s\n' "${still[@]}" | grep . > "$PENDING.new" || true
	mv "$PENDING.new" "$PENDING"
	if [ ${#still[@]} -gt 0 ]; then echo "!! apt: still missing: ${still[*]}"; rc=1
	else echo "apt: optional packages installed"; fi
	# members of libvirt/kvm keep working (groups were created by the installer)
	[ -x /etc/init.d/libvirtd ] && { update-rc.d libvirtd defaults >/dev/null 2>&1; service libvirtd start >/dev/null 2>&1 || true; }
fi

if [ $NET = 0 ]; then
	echo "Flathub/GitHub unreachable: Flatpaks and AppImages wait for the next boot"; rc=1
fi
# 1. Flatpaks (system-wide). Already present on the full ISO -> no-op.
if [ $NET = 1 ] && command -v flatpak >/dev/null; then
	flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || rc=1
	mapfile -t apps < <(grep -vE '^\s*(#|$)' "$FLATPAKS")
	for a in "${apps[@]}"; do
		# Podman Desktop only when the Containers group was selected
		if [ "$a" = io.podman_desktop.PodmanDesktop ] && [ -f "$SELECTED" ] && ! grep -qx podman "$SELECTED"; then
			echo "flatpak $a: skipped (containers group not selected)"; continue; fi
		if flatpak info --system "$a" >/dev/null 2>&1; then echo "flatpak $a: present"; continue; fi
		flatpak install --system -y --noninteractive flathub "$a" || { echo "!! flatpak $a failed"; rc=1; }
	done
	# full ISO: preinstalled apps come from the offline payload -> update them now
	flatpak update --system -y --noninteractive || true
fi

# 2. Fresh AppImages into the system cache; users integrate them at login
[ $NET = 1 ] && { /usr/bin/omaxian-appimage-fetch "$CACHE" || rc=1; }

if [ $rc -eq 0 ]; then
	date -Is > "$STATE/firstboot.done"; echo "first boot provisioning complete"
else
	echo "some steps failed: will retry at next boot"
fi
exit 0
