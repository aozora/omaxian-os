 // the same time, then goes in, as the freedesktop Trash spec has it. Other
 // drives' trash folders, with their own rules, are GIO's to fill, and the
 // item is looked for there once it's gone.
+// Omaxian OS: Qt 6.8 (Devuan Excalibur) has no QDir::mkpath(path, perms)
+// (added in Qt 6.10). Create the path, then set the leaf's mode.
+static bool omaxianMkpath(const QString &path, QFile::Permissions perms) {
+    if (!QDir().mkpath(path))
+        return false;
+    return QFile::setPermissions(path, perms);
+}
