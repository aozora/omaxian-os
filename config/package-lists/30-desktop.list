# Display manager + greeter (themed by omaxian-branding)
lightdm
lightdm-gtk-greeter
# Omaxian (i3 + Quickshell) – pulled in fully by omaxian-session Depends
i3-wm
quickshell
# No XFCE desktop and no Thunar since 0.2 "Space Cat" (file managers: Strata,
# default, and Folio). Only the XFCE pieces the Omaxian shell itself runs:
# i3_autostart starts xfce4-power-manager and tunes it with xfconf-query
# (also omarchy-idle-lock-apply). Its panel plugin is useless without
# xfce4-panel: the trailing "-" keeps apt from pulling it in as a Recommends.
xfce4-power-manager
xfconf
xfce4-power-manager-plugins-
# image viewer (Omaxian's choice; replaces ristretto)
viewnior
xdg-user-dirs-gtk
xdg-desktop-portal-gtk
gnome-keyring
